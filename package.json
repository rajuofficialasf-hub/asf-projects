{
  "name": "asf-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_HOUSING_BACKEND=mock vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build-map": "tsx scripts/build-map.mjs",
    "i18n-check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:mock": "playwright test --project=mock --project=public-mock",
    "test:e2e:rest": "E2E_REST_API_URL=${E2E_REST_API_URL:-http://localhost:3001} playwright test --project=public-rest",
    "test:e2e:rest-admin": "node scripts/e2e-rest-admin.mjs",
    "test:all": "npm run i18n-check && npm run test && npm run check:prod-bundle && npm run test:e2e:mock",
    "check:prod-bundle": "node scripts/check-prod-bundle.mjs",
    "test:contract:rest": "node scripts/contract-rest.mjs",
    "test:contract:rest-readonly": "REST_READONLY_URL=${REST_READONLY_URL:-http://localhost:3001} vitest run tests/contract/rest.readonly.contract.test.ts",
    "field-types-check": "tsx --tsconfig tsconfig.app.json scripts/field-types-check.mjs",
    "build-unions": "node scripts/build-unions.mjs",
    "geo-check": "tsx --tsconfig tsconfig.app.json scripts/geo-check.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify/react": "^6.0.2",
    "@mui/material": "^9.5.0",
    "@mui/stylis-plugin-rtl": "^9.5.0",
    "d3-geo": "^3.1.1",
    "es-toolkit": "^1.52.0",
    "framer-motion": "^12.43.0",
    "minimal-shared": "^1.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "simplebar-react": "^3.3.2",
    "topojson-client": "^3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "mapshaper": "^0.7.70",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
